# Copy this file to ".env" and fill in the values. Never commit ".env".
# Only variables prefixed with EXPO_PUBLIC_ are readable inside the app, so never put secrets
# (e.g. the Supabase secret / service-role key) in here.

# Local Supabase API. Both values are printed by `npm run db:status`.
# On a real phone, replace 127.0.0.1 with the LAN IP address of your PC (see docs/SETUP.md).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: crash reports with Sentry. Leave empty to switch reporting off completely (nothing is
# loaded or sent). A DSN is not a secret key, but only set it when you want reports.
EXPO_PUBLIC_SENTRY_DSN=

# Stripe PUBLISHABLE key (pk_test_...). Safe in the app. Leave empty to keep real money off in the
# app. The secret key (sk_...) and the webhook secret never belong here: they are Supabase secrets
# (see docs/ECHTGELD.md).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
