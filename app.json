{
  "expo": {
    "slug": "push",
    "scheme": "push",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pushchallenge.app"
    },
    "android": {
      "package": "com.pushchallenge.app",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_STEPS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C6FF00"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "PUSH liest deine Lauf-Workouts, Geh- und Laufdistanz sowie Tagesschritte, damit Challenges automatisch geprüft werden können. PUSH schreibt keine Gesundheitsdaten.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "./plugins/with-health-connect-privacy",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-status-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "82e0dc3f-92f8-4b90-8fd2-9a23f4a81d15"
      }
    },
    "owner": "darab2004"
  }
}
