# Copy this file to ".env.production" and fill in the values of your Supabase CLOUD project
# (docs/SETUP.md, section 8). Never commit ".env.production".
#
# EAS cloud builds do not see this file (it is git-ignored). Upload it once, and again after
# every change:   eas env:push production --path .env.production
#
# Only the publishable key belongs here. The secret / service-role key never goes into the app.

# Supabase dashboard → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
